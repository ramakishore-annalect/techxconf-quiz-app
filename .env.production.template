# Production Environment Variables Template
# Copy this to .env.production and fill in your values

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (optional)
REDIS_URL=redis://host:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=another-secret-key-for-jwt-tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
ENVIRONMENT=production
DEBUG=False
APP_NAME=OGS-TechXConf QuizApp
HOST=0.0.0.0
PORT=8000

# CORS - Update with your frontend URL
CORS_ORIGINS=["https://your-frontend-domain.com","https://your-frontend-domain.vercel.app"]

# Session
SESSION_EXPIRE_HOURS=48
QUESTION_TIME_LIMIT_SECONDS=15
